NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
# Optional for health only; required for database-dependent APIs.
# MONGODB_URI=mongodb://127.0.0.1:27017/satyaid_demo?replicaSet=rs0
# Generate a strong random secret (at least 32 characters). Never commit actual values.
# JWT_SECRET=
JWT_ISSUER=satyaid
JWT_AUDIENCE=satyaid-api
# Optional identity-vault keys: independent base64-encoded 32-byte keys.
# APAAR_ENCRYPTION_KEY=
# APAAR_LOOKUP_KEY=
# APAAR_KEY_VERSION=v1
# Seed only against a dedicated development database.
# ALLOW_DEMO_SEED=true
# DEMO_ADMIN_EMAIL=admin@example.invalid
# DEMO_ADMIN_PASSWORD=

# Dedicated base64 32-byte upload staging key; independent from identity/JWT keys.
# UPLOAD_ENCRYPTION_KEY=
# Development only; mock provider is refused in production.
APAAR_PROVIDER=MOCK_APAAR
