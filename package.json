{
  "name": "satyaid-backend",
  "version": "0.1.0",
  "private": true,
  "description": "SatyaID MongoDB backend",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:check": "tsx scripts/check-database.ts",
    "db:indexes": "tsx scripts/create-indexes.ts",
    "db:seed": "tsx scripts/seed.ts",
    "worker": "tsx scripts/upload-worker.ts",
    "demo:samples": "tsx scripts/demo-samples.ts",
    "db:seed:governance": "tsx scripts/seed-governance.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "saxes": "^6.0.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@types/yauzl": "^3.4.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
