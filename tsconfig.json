{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "Node",
    "strict": true, "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true, "noUncheckedIndexedAccess": true,
    "outDir": "dist", "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
